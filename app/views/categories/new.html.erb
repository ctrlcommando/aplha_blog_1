<h1 class="text-center mt-4 text-white">Create a new category</h1>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= render 'shared/errors', obj: @category %>
      <%= form_with(model: @category, data: { turbo: false }, class: "shadow p-3 mb-3 bg-info rounded gap-6", local: true) do |f| %>
        <div class="form-group row mb-3">
          <%= f.label :name, "Category name", class: "col-2 col-form-label text-light" %>
          <div class="col-10">
            <%= f.text_field :name, class: "form-control shadow rounded", placeholder: "Enter a name" %>
          </div>
        </div>

        <div class="form-group d-flex justify-content-center">
          <%= f.submit class: "btn btn-outline-light btn-lg" %>
        </div>
      <% end %>
    
      <div class="mb-3 d-flex justify-content-center">
        <%= link_to 'Back to articles listing', articles_path, class: "text-info align-center btn btn-secondary btn-sm" %>
      </div>
    </div>
  </div>
</div>
